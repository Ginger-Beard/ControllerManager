<UserControl x:Class="ControllerManager.Views.JoystickPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ControllerManager.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:StickViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="120">
    <StackPanel>
        <!-- Label -->
        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,2"/>

        <!-- Pad: square canvas with center crosshair, deadzone ring, position dot.
             SizeChanged on the host Grid keeps the dot's coordinate math anchored
             to the actual rendered pad size.                                     -->
        <Grid x:Name="Pad" Width="100" Height="100"
              Background="#F4F4F4"
              SizeChanged="Pad_SizeChanged">
            <Grid.RenderTransform>
                <ScaleTransform/>
            </Grid.RenderTransform>

            <!-- Border -->
            <Rectangle Stroke="#888" StrokeThickness="1"/>

            <!-- Center crosshair lines -->
            <Line X1="0" Y1="50" X2="100" Y2="50"
                  Stroke="#CCC" StrokeThickness="1"
                  StrokeDashArray="2 2"/>
            <Line X1="50" Y1="0" X2="50" Y2="100"
                  Stroke="#CCC" StrokeThickness="1"
                  StrokeDashArray="2 2"/>

            <!-- Deadzone circle: translucent green tinted ring drawn relative to
                 the pad center. Width/Height bound via converter at code-behind. -->
            <Ellipse x:Name="DeadzoneCircle"
                     Stroke="#60B370" StrokeThickness="1.2"
                     Fill="#1A60B370"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Width="0" Height="0"
                     IsHitTestVisible="False"/>

            <!-- Position dot -->
            <Ellipse x:Name="PositionDot"
                     Width="10" Height="10"
                     Fill="#E07040"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     IsHitTestVisible="False"/>
        </Grid>

        <!-- Status text + calibrate button -->
        <TextBlock Text="{Binding StatusText}"
                   FontSize="10" Foreground="#666"
                   TextWrapping="Wrap"
                   Margin="0,3,0,2"
                   TextAlignment="Center"/>
        <Button Content="Calibrate"
                Command="{Binding CalibrateCommand}"
                FontSize="10" Padding="6,2"
                HorizontalAlignment="Center"
                ToolTip="Measure idle stick drift over 5 seconds — leave the stick at rest"/>
    </StackPanel>
</UserControl>
