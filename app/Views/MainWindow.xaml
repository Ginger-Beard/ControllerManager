<Window x:Class="ControllerManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ControllerManager.ViewModels"
        xmlns:local="clr-namespace:ControllerManager.Views"
        Title="Controller Manager" Height="620" Width="860"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding Settings.AlwaysOnTop}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <TabControl>

            <!-- ── Dashboard ──────────────────────────────────────────────── -->
            <TabItem Header="Dashboard" DataContext="{Binding Dashboard}">
                <DockPanel Margin="12">

                    <!-- Status + buttons (top) -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Profile picker -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Active profile" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,8,0"/>

                            <!-- Launch / Restore buttons -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🎮  Launch"
                                        Command="{Binding LaunchCommand}"
                                        Padding="16,6" FontSize="13"
                                        Background="#3CB371" Foreground="White"/>
                                <Button Content="Restore"
                                        Command="{Binding RestoreCommand}"
                                        Padding="10,6" Margin="6,0,0,0"
                                        ToolTip="Stop any running flow and re-enable all devices"/>
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding StatusText}"
                                       Foreground="Gray" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Device visibility columns -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <TextBlock Grid.Column="0" Grid.Row="0"
                                   Text="System" FontWeight="SemiBold" Foreground="#3CB371"
                                   Margin="0,0,4,1"
                                   ToolTip="Devices accessible to all processes (not in persistent hidden list)"/>
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   FontWeight="SemiBold" Margin="4,0,0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Game"/>
                                    <Setter Property="Foreground" Value="#3CB371"/>
                                    <Setter Property="ToolTip"
                                            Value="Devices accessible to the active game process"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSessionActive}" Value="False">
                                            <Setter Property="Text" Value="Game"/>
                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                            <Setter Property="ToolTip"
                                                    Value="Shown when a game session is active"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Session status line — spans both columns, only visible during a session -->
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                   Text="{Binding SessionText}"
                                   FontStyle="Italic" Foreground="#3CB371" FontSize="11"
                                   Margin="0,0,0,4"
                                   Visibility="{Binding IsSessionActive,
                                       Converter={StaticResource BoolVisConverter}}"/>

                        <!-- System devices list -->
                        <ListBox Grid.Column="0" Grid.Row="2" Margin="0,0,4,0"
                                 ItemsSource="{Binding SystemDevices}"
                                 BorderThickness="1" BorderBrush="#CCC" FontSize="11"/>

                        <!-- Game devices list -->
                        <ListBox Grid.Column="1" Grid.Row="2" Margin="4,0,0,0"
                                 ItemsSource="{Binding GameDevices}"
                                 BorderThickness="1" BorderBrush="#CCC" FontSize="11">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSessionActive}" Value="False">
                                            <Setter Property="Background" Value="#F8F8F8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                    </Grid>

                    <!-- Activity log -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Copy All"
                                Command="{Binding CopyLogCommand}"
                                Padding="8,2"/>
                        <TextBlock Text="Activity log" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="ActivityLogList"
                             ItemsSource="{Binding ActivityLog}"
                             FontFamily="Consolas" FontSize="11"
                             BorderThickness="1" BorderBrush="#CCC"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                </DockPanel>
            </TabItem>

            <!-- ── Games ──────────────────────────────────────────────────── -->
            <TabItem Header="Games" DataContext="{Binding Games}">
                <local:GamesView/>
            </TabItem>

            <!-- ── Devices ────────────────────────────────────────────────── -->
            <TabItem Header="Devices" DataContext="{Binding Devices}">
                <DockPanel Margin="8">

                    <!-- Purpose banner -->
                    <Border DockPanel.Dock="Top"
                            Background="#FFF8E7" BorderBrush="#E8D8A0" BorderThickness="1"
                            CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" Foreground="#7A6020" FontSize="11">
                            Devices turned off here are hidden from your entire computer.
                            To hide devices only while a specific game runs, use the Games tab.
                        </TextBlock>
                    </Border>

                    <!-- Toolbar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Right"
                                  Content="Show all devices"
                                  IsChecked="{Binding ShowAllHid}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0"/>
                        <Button Content="Copy All"
                                Command="{Binding CopyAllCommand}"
                                DockPanel.Dock="Right"
                                Padding="12,4" Margin="4,0,0,0"/>
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                DockPanel.Dock="Right"
                                Padding="12,4" Margin="4,0,0,0"/>
                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                    </DockPanel>

                    <!-- Live input monitor (bottom dock — only polls while expanded) -->
                    <Expander DockPanel.Dock="Bottom"
                              Header="Input Monitor"
                              IsExpanded="{Binding IsMonitorExpanded}"
                              MaxHeight="280"
                              Margin="0,4,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <DockPanel>

                                <!-- Joystick pads (auto-detected X/Y, Rx/Ry, Z/Rz pairs). Wraps so
                                     multiple sticks lay out horizontally on a typical gamepad. -->
                                <ItemsControl DockPanel.Dock="Top"
                                              ItemsSource="{Binding Sticks}"
                                              Margin="4,2,4,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:JoystickPad Margin="0,0,12,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Axes + Buttons side-by-side underneath -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Axes — name, raw value, fill bar (with deadzone band overlay),
                                         and a Calibrate button. Calibration status text appears below
                                         the row when a measurement is in progress or has been recorded. -->
                                    <ItemsControl Grid.Column="0"
                                                  ItemsSource="{Binding Axes}"
                                                  Margin="4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" Width="48"
                                                                   FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RawText}" Width="40"
                                                                   FontSize="10" Foreground="Gray"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Right" Margin="2,0"/>
                                                        <Button DockPanel.Dock="Right"
                                                                Content="cal"
                                                                Command="{Binding CalibrateCommand}"
                                                                FontSize="9" Padding="4,0"
                                                                Margin="4,0,0,0"
                                                                MinWidth="22"
                                                                ToolTip="Hold the axis at rest for 5s — measures idle drift and recommends a deadzone"/>
                                                        <local:AxisBar/>
                                                    </DockPanel>
                                                    <!-- Calibration status — only visible after a measurement -->
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="9" Foreground="#666"
                                                               Margin="48,0,0,0"
                                                               Visibility="{Binding StatusText,
                                                                   Converter={StaticResource NullOrEmptyVisConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Buttons -->
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Buttons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="22" Height="22" Margin="2"
                                                        CornerRadius="3"
                                                        ToolTip="{Binding Label}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DDDDDD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                    <Setter Property="Background" Value="#3CB371"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Label}" FontSize="9"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                            </DockPanel>
                        </ScrollViewer>
                    </Expander>

                    <!-- Device list -->
                    <ListView ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              BorderThickness="1"
                              BorderBrush="#CCCCCC">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnDeviceItemRightClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Copy name"
                                          Command="{Binding CopyFriendlyNameCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                                <MenuItem Header="Copy VID:PID"
                                          Command="{Binding CopyVidPidCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                                <MenuItem Header="Copy instance ID"
                                          Command="{Binding CopyInstanceIdCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                                <MenuItem Header="Copy interface path"
                                          Command="{Binding CopyInterfacePathCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>

                                <!-- State dot -->
                                <GridViewColumn Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#3CB371"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Fill" Value="#BBBBBB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Friendly name — VID:PID in tooltip, instance ID via context menu -->
                                <GridViewColumn Header="Device">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FriendlyName}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding VidPidShort}" Foreground="Gray"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Enable/disable toggle -->
                                <GridViewColumn Header="State" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="8,2"
                                                    Command="{Binding DataContext.ToggleEnabledCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="ON"/>
                                                        <Setter Property="Background" Value="#3CB371"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Content" Value="OFF"/>
                                                                <Setter Property="Background" Value="#DDDDDD"/>
                                                                <Setter Property="Foreground" Value="#444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                            </GridView>
                        </ListView.View>
                    </ListView>

                </DockPanel>
            </TabItem>

            <!-- ── Settings ───────────────────────────────────────────────── -->
            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <StackPanel Margin="16" MaxWidth="480" HorizontalAlignment="Left">

                    <!-- HidHide status -->
                    <TextBlock Text="Device hiding" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="HidHide  " VerticalAlignment="Center"/>
                        <!-- Installed -->
                        <TextBlock Foreground="#3CB371" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding HidHideInstalled, Converter={StaticResource BoolVisConverter}}">
                            <Hyperlink Command="{Binding OpenHidHideHomeCommand}"
                                       Foreground="#3CB371">✓ Installed</Hyperlink>
                        </TextBlock>
                        <!-- Not installed -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HidHideInstalled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="✗ Not installed  " Foreground="#CC4444" FontWeight="SemiBold"/>
                            <TextBlock><Hyperlink Command="{Binding OpenHidHideDownloadCommand}">Download ↗</Hyperlink></TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,0,0,12"/>

                    <TextBlock Text="General" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                    <CheckBox Content="Pin window to top"
                              IsChecked="{Binding AlwaysOnTop}"
                              Margin="0,0,0,8"
                              ToolTip="Keep this window above all others — useful on single monitors when watching the activity log while a game launches."/>

                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}"
                              Margin="0,0,0,8"
                              ToolTip="Adds Controller Manager to the Windows startup registry key so it launches automatically on login."/>

                    <CheckBox Content="Start minimized to tray"
                              IsChecked="{Binding StartMinimized}"
                              Margin="0,0,0,8"
                              ToolTip="Launch silently in the system tray. Double-click the tray icon to open the window."/>

                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                        Auto-trigger on game launch is set per-profile in the Games tab.
                    </TextBlock>

                    <Separator Margin="0,8,0,12"/>

                    <TextBlock Text="Logging" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Log level:"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding LogLevels}"
                                  SelectedItem="{Binding LogLevel}"
                                  Width="120" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Log file:"
                                   VerticalAlignment="Center"/>
                        <DockPanel Grid.Row="1" Grid.Column="1"
                                   ToolTip="Log file location — Off means no file is written">
                            <Button DockPanel.Dock="Right" Content="Open folder"
                                    Command="{Binding OpenLogFolderCommand}"
                                    Padding="8,2" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding LogFilePath}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="Gray"
                                       FontFamily="Consolas" FontSize="11"/>
                        </DockPanel>
                    </Grid>

                    <Separator Margin="0,8,0,12"/>

                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="Controller Manager — per-game HID device profile manager."/>
                        <LineBreak/>
                        <Run Text="Source: "/>
                        <Hyperlink Command="{Binding OpenRepoCommand}">github.com/Ginger-Beard/ControllerManager</Hyperlink>
                    </TextBlock>

                    <Border Background="#F0F8F4" BorderBrush="#B8DEC8" BorderThickness="1"
                            CornerRadius="3" Padding="10,8" Margin="0,0,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="#2A5A3A" FontSize="11">
                            <Run FontWeight="SemiBold" Text="Huge thanks to Nefarius (Benjamin Höglinger-Stelzer)"/>
                            <Run Text=" for "/>
                            <Hyperlink Command="{Binding OpenHidHideHomeCommand}" Foreground="#2A7A4A">HidHide</Hyperlink>
                            <Run Text=" — the signed kernel driver that does the actual device hiding. Controller Manager is nothing without it. Check out his work at "/>
                            <Hyperlink Command="{Binding OpenNefariusCommand}" Foreground="#2A7A4A">nefarius.at</Hyperlink>
                            <Run Text="."/>
                        </TextBlock>
                    </Border>

                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
