<Window x:Class="HIDReorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HIDReorder.ViewModels"
        xmlns:local="clr-namespace:HIDReorder.Views"
        Title="HID Reorder" Height="620" Width="860"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding Settings.AlwaysOnTop}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <TabControl>

            <!-- ── Dashboard ──────────────────────────────────────────────── -->
            <TabItem Header="Dashboard" DataContext="{Binding Dashboard}">
                <DockPanel Margin="12">

                    <!-- Status + buttons (top) -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Profile picker -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Active profile" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,8,0"/>

                            <!-- Launch / Abort buttons -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🎮  Launch"
                                        Command="{Binding LaunchCommand}"
                                        Padding="16,6" FontSize="13"
                                        Background="#3CB371" Foreground="White"/>
                                <Button Content="Abort"
                                        Command="{Binding AbortCommand}"
                                        Padding="10,6" Margin="6,0,0,0"/>
                                <Button Content="Restore All"
                                        Command="{Binding RestoreAllCommand}"
                                        Padding="10,6" Margin="6,0,0,0"
                                        ToolTip="Re-enable all devices this app has disabled"/>
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding StatusText}"
                                       Foreground="Gray" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Device summary -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Keep Enabled"
                                   FontWeight="SemiBold" Foreground="#3CB371" Margin="0,0,4,2"/>
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="Disable → Re-enable"
                                   FontWeight="SemiBold" Foreground="#E07040" Margin="4,0,4,2"/>
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="Keep Disabled"
                                   FontWeight="SemiBold" Foreground="#888" Margin="4,0,0,2"/>

                        <ListBox Grid.Column="0" Grid.Row="1" Margin="0,0,4,0"
                                 ItemsSource="{Binding KeepEnabled}"
                                 DisplayMemberPath="FriendlyName"
                                 BorderThickness="1" BorderBrush="#CCC" FontSize="11"/>
                        <ListBox Grid.Column="1" Grid.Row="1" Margin="4,0,4,0"
                                 ItemsSource="{Binding DisableThenRestore}"
                                 DisplayMemberPath="FriendlyName"
                                 BorderThickness="1" BorderBrush="#CCC" FontSize="11"/>
                        <ListBox Grid.Column="2" Grid.Row="1" Margin="4,0,0,0"
                                 ItemsSource="{Binding KeepDisabled}"
                                 DisplayMemberPath="FriendlyName"
                                 BorderThickness="1" BorderBrush="#CCC" FontSize="11"/>
                    </Grid>

                    <!-- Activity log -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Copy All"
                                Command="{Binding CopyLogCommand}"
                                Padding="8,2"/>
                        <TextBlock Text="Activity log" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="ActivityLogList"
                             ItemsSource="{Binding ActivityLog}"
                             FontFamily="Consolas" FontSize="11"
                             BorderThickness="1" BorderBrush="#CCC"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                </DockPanel>
            </TabItem>

            <!-- ── Games ──────────────────────────────────────────────────── -->
            <TabItem Header="Games" DataContext="{Binding Games}">
                <local:GamesView/>
            </TabItem>

            <!-- ── Devices ────────────────────────────────────────────────── -->
            <TabItem Header="Devices" DataContext="{Binding Devices}">
                <DockPanel Margin="8">

                    <!-- Toolbar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Right"
                                  Content="Show all HID"
                                  IsChecked="{Binding ShowAllHid}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0"/>
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                DockPanel.Dock="Right"
                                Padding="12,4" Margin="4,0,0,0"/>
                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                    </DockPanel>

                    <!-- Device list -->
                    <ListView ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              BorderThickness="1"
                              BorderBrush="#CCCCCC">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnDeviceItemRightClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Copy name"
                                          Command="{Binding CopyFriendlyNameCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                                <MenuItem Header="Copy VID:PID"
                                          Command="{Binding CopyVidPidCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                                <MenuItem Header="Copy instance ID"
                                          Command="{Binding CopyInstanceIdCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                                <MenuItem Header="Copy interface path"
                                          Command="{Binding CopyInterfacePathCommand}"
                                          CommandParameter="{Binding SelectedDevice}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>

                                <!-- State dot -->
                                <GridViewColumn Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#3CB371"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Fill" Value="#BBBBBB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Friendly name -->
                                <GridViewColumn Header="Device" Width="320"
                                                DisplayMemberBinding="{Binding FriendlyName}"/>

                                <!-- VID:PID badge -->
                                <GridViewColumn Header="VID:PID" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VidPidShort}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#555"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Enable/disable toggle -->
                                <GridViewColumn Header="State" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="8,2"
                                                    Command="{Binding DataContext.ToggleEnabledCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="ON"/>
                                                        <Setter Property="Background" Value="#3CB371"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Content" Value="OFF"/>
                                                                <Setter Property="Background" Value="#DDDDDD"/>
                                                                <Setter Property="Foreground" Value="#444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Instance ID (click to copy) -->
                                <GridViewColumn Header="Instance ID" Width="240">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstanceId}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="#777"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InstanceId}"
                                                       Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.CopyInstanceIdCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                  CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                            </GridView>
                        </ListView.View>
                    </ListView>

                </DockPanel>
            </TabItem>

            <!-- ── Settings ───────────────────────────────────────────────── -->
            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <StackPanel Margin="16" MaxWidth="480" HorizontalAlignment="Left">

                    <TextBlock Text="General" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                    <CheckBox Content="Pin window to top"
                              IsChecked="{Binding AlwaysOnTop}"
                              Margin="0,0,0,8"
                              ToolTip="Keep this window above all others — useful on single monitors when watching the activity log while a game launches."/>

                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}"
                              Margin="0,0,0,8"
                              ToolTip="Adds HID Reorder to the Windows startup registry key so it launches automatically on login."/>

                    <CheckBox Content="Start minimized to tray"
                              IsChecked="{Binding StartMinimized}"
                              Margin="0,0,0,8"
                              ToolTip="Launch silently in the system tray. Double-click the tray icon to open the window."/>

                    <CheckBox Content="Enable process watcher"
                              IsChecked="{Binding ProcessWatcherEnabled}"
                              Margin="0,0,0,8"
                              ToolTip="Polls every 500ms for configured game executables and triggers the profile flow automatically when detected. Disable if you always launch via the in-app button, Steam command, or shortcut."/>

                    <Separator Margin="0,8,0,12"/>

                    <TextBlock Text="Logging" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Log level:"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding LogLevels}"
                                  SelectedItem="{Binding LogLevel}"
                                  Width="120"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4"
                               ToolTip="Log file location — Off means no file is written">
                        <Button DockPanel.Dock="Right" Content="Open folder"
                                Command="{Binding OpenLogFolderCommand}"
                                Padding="8,2" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding LogFilePath}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="Gray"
                                   FontFamily="Consolas" FontSize="11"/>
                    </DockPanel>

                    <Separator Margin="0,8,0,12"/>

                    <TextBlock Text="About" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap">
                        <Run Text="HID Reorder — per-game HID device profile manager."/>
                        <LineBreak/>
                        <Run Text="Source: github.com/JoshRacine/hid-reorder"/>
                    </TextBlock>

                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
