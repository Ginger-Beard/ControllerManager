<Window x:Class="ControllerManager.Views.HidHideInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidHide required"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="16" FontWeight="SemiBold"
                   Text="HidHide isn't installed"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   Text="Controller Manager needs the HidHide kernel driver to hide and reveal devices. Without it, your profiles won't do anything.&#x0a;&#x0a;Click Install to download and set it up automatically — it takes about a minute."
                   Margin="0,0,0,16"/>

        <!-- Status row: hidden until an install starts. -->
        <StackPanel Grid.Row="2" x:Name="StatusPanel"
                    Visibility="Collapsed" Margin="0,0,0,16">
            <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True"/>
            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0" Foreground="#555"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="DontRemindCheckbox" Grid.Column="0"
                      Content="Don't remind me again"
                      VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SkipButton"
                        Content="Skip"
                        MinWidth="100" Height="30" Margin="0,0,8,0"
                        Click="Skip_Click"/>
                <Button x:Name="InstallButton"
                        Content="Install HidHide"
                        MinWidth="120" Height="30"
                        IsDefault="True"
                        Click="Install_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
