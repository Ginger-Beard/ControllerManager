<UserControl x:Class="HIDReorder.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:HIDReorder.Models">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Profile list ──────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="+" Width="36" Command="{Binding NewProfileCommand}" ToolTip="New profile"/>
                <Button Content="−" Width="36" Margin="4,0,0,0"
                        Command="{Binding DeleteProfileCommand}" ToolTip="Delete selected profile"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     DisplayMemberPath="Name"
                     BorderThickness="1" BorderBrush="#CCC"/>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD"/>

        <!-- ── Profile editor ────────────────────────────────── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" IsEnabled="{Binding HasSelection}">

                <!-- Name + exe -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="Profile name"
                           FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBox Grid.Column="0" Grid.Row="1"
                             Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Column="2" Grid.Row="0" Content="Game executable"
                           FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <DockPanel Grid.Column="2" Grid.Row="1">
                        <Button DockPanel.Dock="Right" Content="Browse…"
                                Command="{Binding BrowseExeCommand}"
                                Padding="8,3" Margin="4,0,0,0"/>
                        <TextBox Text="{Binding Editor.ExePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Editor.ExePath}"/>
                    </DockPanel>
                </Grid>

                <!-- Trigger mode -->
                <Label Content="Re-enable trigger" FontWeight="SemiBold" Padding="0,0,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton Content="Handle watcher"
                                 IsChecked="{Binding Editor.TriggerMode,
                                     Converter={StaticResource EnumBoolConverter},
                                     ConverterParameter={x:Static models:TriggerMode.HandleWatcher}}"
                                 Margin="0,0,12,0"
                                 ToolTip="Re-enable Disable-Before-Launch devices as the game opens HID handles (recommended)"/>
                    <RadioButton Content="Timer"
                                 IsChecked="{Binding Editor.TriggerMode,
                                     Converter={StaticResource EnumBoolConverter},
                                     ConverterParameter={x:Static models:TriggerMode.Timer}}"
                                 ToolTip="Re-enable after a fixed number of seconds"/>
                </StackPanel>

                <!-- Timer delay -->
                <DockPanel Margin="0,0,0,10"
                           Visibility="{Binding Editor.TriggerMode,
                               Converter={StaticResource EnumVisConverter},
                               ConverterParameter={x:Static models:TriggerMode.Timer}}">
                    <Label DockPanel.Dock="Left" Content="Delay:" VerticalAlignment="Center"/>
                    <Label DockPanel.Dock="Right" Content="s" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    <TextBox DockPanel.Dock="Right" Width="50" VerticalContentAlignment="Center"
                             Text="{Binding Editor.TimerSeconds}"
                             ToolTip="Seconds (5–300)"/>
                    <Slider Minimum="5" Maximum="300" TickFrequency="1"
                            Value="{Binding Editor.TimerSeconds}" Margin="0,0,6,0"/>
                </DockPanel>

                <Separator Margin="0,0,0,10"/>

                <!-- Three device lists -->
                <Label Content="Device assignment" FontWeight="SemiBold" Padding="0,0,0,4"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Headers -->
                    <TextBlock Grid.Column="0" Grid.Row="0"
                               Text="Keep Enabled" FontWeight="SemiBold"
                               Foreground="#3CB371" Margin="0,0,4,2"/>
                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="Disable → Re-enable" FontWeight="SemiBold"
                               Foreground="#E07040" Margin="4,0,4,2"/>
                    <TextBlock Grid.Column="2" Grid.Row="0"
                               Text="Keep Disabled" FontWeight="SemiBold"
                               Foreground="#888" Margin="4,0,0,2"/>

                    <!-- Keep Enabled list -->
                    <ListBox Grid.Column="0" Grid.Row="1" Margin="0,0,4,0"
                             ItemsSource="{Binding Editor.KeepEnabled}"
                             SelectedItem="{Binding Editor.SelectedKeep}"
                             DisplayMemberPath="FriendlyName"
                             BorderThickness="1" BorderBrush="#CCC"/>

                    <!-- Disable→Restore list -->
                    <ListBox Grid.Column="1" Grid.Row="1" Margin="4,0,4,0"
                             ItemsSource="{Binding Editor.DisableThenRestore}"
                             SelectedItem="{Binding Editor.SelectedDisable}"
                             DisplayMemberPath="FriendlyName"
                             BorderThickness="1" BorderBrush="#CCC"/>

                    <!-- Keep Disabled list -->
                    <ListBox Grid.Column="2" Grid.Row="1" Margin="4,0,0,0"
                             ItemsSource="{Binding Editor.KeepDisabled}"
                             SelectedItem="{Binding Editor.SelectedKeepDisabled}"
                             DisplayMemberPath="FriendlyName"
                             BorderThickness="1" BorderBrush="#CCC"/>

                    <!-- Remove / reorder buttons -->
                    <Button Grid.Column="0" Grid.Row="2" Content="Remove"
                            Command="{Binding Editor.RemoveKeepCommand}"
                            Margin="0,4,4,0" Padding="4,2"/>

                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="4,4,4,0">
                        <Button Content="Remove" Command="{Binding Editor.RemoveDisableCommand}"
                                Padding="4,2"/>
                        <Button Content="↑" Width="26" Margin="4,0,0,0"
                                Command="{Binding Editor.MoveDisableUpCommand}"
                                ToolTip="Re-enabled first"/>
                        <Button Content="↓" Width="26" Margin="2,0,0,0"
                                Command="{Binding Editor.MoveDisableDownCommand}"
                                ToolTip="Re-enabled last"/>
                    </StackPanel>

                    <Button Grid.Column="2" Grid.Row="2" Content="Remove"
                            Command="{Binding Editor.RemoveKeepDisabledCommand}"
                            Margin="4,4,0,0" Padding="4,2" HorizontalAlignment="Left"/>
                </Grid>

                <!-- Detected device picker -->
                <DockPanel Margin="0,12,0,2">
                    <CheckBox DockPanel.Dock="Right"
                              Content="Show all HID"
                              IsChecked="{Binding Editor.ShowAllHid}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"/>
                    <TextBlock>
                        <Run Text="Detected devices — select then assign"/>
                        <Run Text=" &#x2139;" Foreground="#888"
                             ToolTip="Unassigned devices are not touched by this profile.&#x0a;Assign a device to at least one list if you want this profile to manage it."/>
                    </TextBlock>
                </DockPanel>
                <ListBox ItemsSource="{Binding Editor.UnassignedDevices}"
                         SelectedItem="{Binding Editor.SelectedAvailable}"
                         DisplayMemberPath="FriendlyName"
                         Height="110"
                         BorderThickness="1" BorderBrush="#CCC"
                         Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="→ Keep Enabled"
                            Command="{Binding Editor.AddToKeepCommand}"
                            Padding="8,3" Foreground="#3CB371"/>
                    <Button Content="→ Disable → Re-enable"
                            Command="{Binding Editor.AddToDisableCommand}"
                            Padding="8,3" Margin="6,0" Foreground="#E07040"/>
                    <Button Content="→ Keep Disabled"
                            Command="{Binding Editor.AddToKeepDisabledCommand}"
                            Padding="8,3" Foreground="#888"/>
                </StackPanel>

                <Separator Margin="0,0,0,8"/>

                <!-- Actions row: shortcuts + steam left, save right -->
                <DockPanel Margin="0,0,0,12">

                    <!-- Save + unsaved indicator — docked right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Unsaved changes" Foreground="Orange"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding Editor.IsDirty,
                                       Converter={StaticResource BoolVisConverter}}"/>
                        <Button Content="Save Profile"
                                Command="{Binding SaveProfileCommand}"
                                Padding="14,5" Background="#3CB371" Foreground="White"/>
                    </StackPanel>

                    <!-- Left group: shortcuts + steam -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CreateDesktopShortcutCommand}"
                                Padding="8,4"
                                ToolTip="Create a desktop shortcut that launches this profile directly">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Desktop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CreateStartMenuShortcutCommand}"
                                Padding="8,4" Margin="6,0,0,0"
                                ToolTip="Add a shortcut to the Start Menu Programs folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Start Menu" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopySteamCommandCommand}"
                                Padding="8,4" Margin="6,0,0,0"
                                ToolTip="Copy the Steam Launch Options command.&#x0a;Paste into Steam → right-click game → Properties → Launch Options.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Steam Command" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>

                <!-- Handle Watcher debug panel -->
                <Expander IsExpanded="False" Margin="0,0,0,8"
                          DataContext="{Binding HandleWatcher}">
                    <Expander.Header>
                        <TextBlock>
                            <Run Text="Handle Watcher" FontWeight="SemiBold"/>
                            <Run Text=" — debug tool to verify device enumeration for this game"
                                 Foreground="Gray" FontSize="11"/>
                        </TextBlock>
                    </Expander.Header>

                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                        <DockPanel>
                            <!-- Controls -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Clear"
                                        Command="{Binding ClearCommand}" Padding="8,3" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="Copy All"
                                        Command="{Binding CopyAllCommand}" Padding="8,3" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="Stop"
                                        Command="{Binding StopCommand}" Padding="8,3" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="Start"
                                        Command="{Binding StartCommand}" Padding="8,3" Margin="4,0,0,0"/>
                                <CheckBox DockPanel.Dock="Right" Content="All handles"
                                          IsChecked="{Binding DiagnosticMode}"
                                          VerticalAlignment="Center" Margin="8,0,0,0"
                                          ToolTip="Also show all \Device\ handles beyond HID and DirectInput.&#x0a;Normal mode captures \Device\HID* (RawInput/WGI games) and&#x0a;\Registry\...\DirectInput\* (DirectInput games like FH6) automatically."/>
                                <TextBox DockPanel.Dock="Right" Width="180"
                                         Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="4,0,0,0" VerticalContentAlignment="Center"
                                         ToolTip="Auto-filled from the profile's game executable name"/>
                                <TextBlock DockPanel.Dock="Right" Text="Process:"
                                           VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="Gray"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <!-- Poll stats -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PollStats}"
                                       Foreground="Gray" FontSize="10" Margin="0,0,0,4"/>

                            <!-- Event log -->
                            <ListView ItemsSource="{Binding Events}" Height="140"
                                      FontFamily="Consolas" FontSize="11"
                                      BorderThickness="1" BorderBrush="#DDD"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Time"   Width="90"
                                                        DisplayMemberBinding="{Binding Timestamp}"/>
                                        <GridViewColumn Header="Device" Width="200"
                                                        DisplayMemberBinding="{Binding DeviceName}"/>
                                        <GridViewColumn Header="Handle path"
                                                        DisplayMemberBinding="{Binding Path}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
