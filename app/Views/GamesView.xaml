<UserControl x:Class="ControllerManager.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ControllerManager.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Profile list ──────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="+" Width="28" Command="{Binding NewProfileCommand}" ToolTip="New profile"/>
                    <Button Content="−" Width="28" Margin="3,0,0,0"
                            Command="{Binding DeleteProfileCommand}" ToolTip="Delete selected profile"/>
                    <Button Content="Export" Margin="6,0,0,0" Padding="6,2"
                            Command="{Binding ExportProfileCommand}" ToolTip="Export selected profile to JSON"/>
                    <Button Content="Import" Margin="3,0,0,0" Padding="6,2"
                            Command="{Binding ImportProfileCommand}" ToolTip="Import profile from JSON"/>
                </StackPanel>
                <TextBlock Text="{Binding HealStatusText}"
                           Foreground="#E07040" FontSize="10"
                           TextWrapping="Wrap" Margin="0,5,0,0"
                           Visibility="{Binding HealStatusText,
                               Converter={StaticResource NullOrEmptyVisConverter}}"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     DisplayMemberPath="Name"
                     BorderThickness="1" BorderBrush="#CCC"/>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD"/>

        <!-- ── Profile editor ──────────────────────────────────
             Outer layout is a Grid (not ScrollViewer + StackPanel) so the two
             device lists can share a Star-sized middle row that grows with the
             window. A horizontal GridSplitter between them lets the user
             redistribute space without resizing the whole window.            -->
        <Grid Grid.Column="2" Margin="12" IsEnabled="{Binding HasSelection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- name + exe + auto-trigger + pause -->
                <RowDefinition Height="Auto"/>   <!-- separator -->
                <RowDefinition Height="Auto"/>   <!-- "Devices in this profile" label -->
                <RowDefinition Height="2*" MinHeight="100"/>   <!-- Assignments list -->
                <RowDefinition Height="6"/>      <!-- splitter -->
                <RowDefinition Height="Auto"/>   <!-- Picker label + show-all -->
                <RowDefinition Height="*" MinHeight="80"/>     <!-- Picker list -->
                <RowDefinition Height="Auto"/>   <!-- Add buttons -->
                <RowDefinition Height="Auto"/>   <!-- separator -->
                <RowDefinition Height="Auto"/>   <!-- actions row -->
            </Grid.RowDefinitions>

            <!-- ── Top: name + exe + toggles ──────────────────────────────── -->
            <StackPanel Grid.Row="0">

                <!-- Name + exe -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="Profile name"
                           FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <TextBox Grid.Column="0" Grid.Row="1"
                             Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Column="2" Grid.Row="0" Content="Game executable"
                           FontWeight="SemiBold" Padding="0,0,0,2"/>
                    <DockPanel Grid.Column="2" Grid.Row="1">
                        <Button DockPanel.Dock="Right" Content="Browse…"
                                Command="{Binding BrowseExeCommand}"
                                Padding="8,3" Margin="4,0,0,0"/>
                        <TextBox Text="{Binding Editor.ExePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Editor.ExePath}"/>
                    </DockPanel>
                </Grid>

                <!-- Auto-trigger toggle (per-profile) -->
                <CheckBox Content="Auto-trigger this profile when the game launches"
                          IsChecked="{Binding Editor.ProcessWatcherEnabled}"
                          Margin="0,0,0,4"
                          ToolTip="When on, Controller Manager will detect the game starting and apply this profile automatically. When off, you must launch via the Dashboard, a shortcut, or the Steam wrapper."/>

                <!-- Reveal-phase controls — only meaningful when the profile has
                     at least one Reveal After Start device. Everything in here
                     hides when the user's only got Always Visible devices. -->
                <StackPanel Visibility="{Binding Editor.HasRevealAfterStart,
                                                 Converter={StaticResource BoolVisConverter}}">

                    <CheckBox Content="Wait until the game opens the first device before revealing the rest"
                              IsChecked="{Binding Editor.WaitForFirstDevice}"
                              Margin="0,4,0,0"
                              ToolTip="When on, Controller Manager watches for the moment the game touches your wheel and then reveals the rest. Faster and more reliable for FFB games like Forza. When off, each device reveals at the fixed time you set on its row below."/>

                    <!-- Post-acquisition grace period — only meaningful when the checkbox is on -->
                    <DockPanel Margin="20,4,0,0"
                               Visibility="{Binding Editor.WaitForFirstDevice,
                                   Converter={StaticResource BoolVisConverter}}"
                               ToolTip="After the game touches your wheel, wait this many seconds before revealing everything else. The pause gives the game time to lock your wheel into slot #1 before the pedals and shifter show up. 1.5s works for most games; bump it to 2 or 2.5 if your wheel still ends up in the wrong slot.">
                        <TextBlock DockPanel.Dock="Left" Text="Wait this many seconds after:"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="s"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <TextBox DockPanel.Dock="Right" Width="48" VerticalContentAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Text="{Binding Editor.PostAcquisitionDelaySeconds,
                                                UpdateSourceTrigger=LostFocus,
                                                StringFormat={}{0:0.###},
                                                ConverterCulture=en-US}"/>
                        <Border/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,0,0,10"/>

            <!-- ── Assignments label + explainer + live preview ──────────── -->
            <StackPanel Grid.Row="2" Margin="0,4,0,4">
                <DockPanel>
                    <Label DockPanel.Dock="Left" Content="Devices in this profile"
                           FontWeight="SemiBold" Padding="0"/>
                    <TextBlock Foreground="#888" FontStyle="Italic" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="Drag ☰ to reorder."/>
                </DockPanel>

                <!-- Static explainer: how the roles + 'not in list' work -->
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="#666" FontSize="11">
                    <Run FontWeight="SemiBold">Always Visible</Run><Run Text=" — the game sees this device immediately at launch (your wheel, your gamepad)."/><LineBreak/>
                    <Run FontWeight="SemiBold">Reveal After Start</Run><Run Text=" — hidden when the game starts, then appears at the time you set on its row. Staggered times (e.g. 11.0, 11.1, 11.2) give each device its own in-game slot."/><LineBreak/>
                    <Run Text="Anything not in this list is hidden during the game."/>
                </TextBlock>

                <!-- Live preview: built from current state, updates as user tweaks -->
                <Border Background="#F4F8FC" BorderBrush="#BFD0E0" BorderThickness="1"
                        Padding="8,6" Margin="0,6,0,0" CornerRadius="3">
                    <TextBlock Text="{Binding Editor.Timeline}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#333"/>
                </Border>
            </StackPanel>

            <!-- ── Assignments list (resizable, drag-drop reorderable) ────── -->
            <Border Grid.Row="3" BorderBrush="#CCC" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              AllowDrop="True"
                              DragOver="AssignmentRow_DragOver"
                              Drop="AssignmentsHost_Drop">
                    <ItemsControl ItemsSource="{Binding Editor.Assignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceAssignmentViewModel}">
                                <!-- Whole row is a drop target; drag handle ☰ is the drag source -->
                                <Border Background="Transparent" Margin="0" Padding="4,3"
                                        AllowDrop="True"
                                        DragOver="AssignmentRow_DragOver"
                                        DragLeave="AssignmentRow_DragLeave"
                                        Drop="AssignmentRow_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>  <!-- ☰ drag handle -->
                                            <ColumnDefinition Width="*"/>     <!-- name -->
                                            <ColumnDefinition Width="64"/>    <!-- delay -->
                                            <ColumnDefinition Width="Auto"/>  <!-- role -->
                                            <ColumnDefinition Width="Auto"/>  <!-- ↑ -->
                                            <ColumnDefinition Width="Auto"/>  <!-- ↓ -->
                                            <ColumnDefinition Width="Auto"/>  <!-- ✕ -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Drag handle: click and drag to reorder -->
                                        <Border Grid.Column="0" Width="20" Background="Transparent"
                                                Cursor="SizeAll"
                                                VerticalAlignment="Stretch"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,4,0"
                                                ToolTip="Drag to reorder"
                                                PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="DragHandle_PreviewMouseMove">
                                            <TextBlock Text="☰" FontSize="14" Foreground="#888"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FriendlyName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0"/>

                                        <!-- Reveal time: absolute seconds from game launch. Visible for
                                             RevealAfterStart rows in both modes — in acquisition mode, the
                                             values act as a safety net upper bound if the ETW signal doesn't
                                             fire (some games use RawInput/WGI and never open the device file
                                             directly, so the signal never arrives). Column reserves width
                                             either way so the role dropdown doesn't shift. -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRevealAfterStart}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Reveal at" VerticalAlignment="Center" Margin="0,0,3,0"
                                                       Foreground="#888" FontSize="11"/>
                                            <TextBox Width="40" VerticalContentAlignment="Center"
                                                     Text="{Binding DelaySeconds,
                                                                    UpdateSourceTrigger=LostFocus,
                                                                    StringFormat={}{0:0.###},
                                                                    ConverterCulture=en-US}"
                                                     ToolTip="How many seconds after the game starts before this device is revealed. Stagger pedals and shifter slightly so they get the right in-game slot (e.g. 11, 11.1, 11.2). If acquisition mode is on, the reveal happens sooner when the game opens the wheel — these numbers then act as a fallback."/>
                                            <TextBlock Text="s" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                        </StackPanel>

                                        <ComboBox Grid.Column="3"
                                                  Width="140"
                                                  ItemsSource="{x:Static vm:DeviceAssignmentViewModel.AllRoles}"
                                                  SelectedValue="{Binding Role}"
                                                  SelectedValuePath="Role"
                                                  DisplayMemberPath="Name"
                                                  VerticalAlignment="Center"/>

                                        <Button Grid.Column="4" Content="↑" Width="22" Margin="6,0,0,0"
                                                Command="{Binding DataContext.Editor.MoveUpCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Move up. Devices reveal top-to-bottom — first device in the list gets the next available controller slot."/>
                                        <Button Grid.Column="5" Content="↓" Width="22" Margin="2,0,0,0"
                                                Command="{Binding DataContext.Editor.MoveDownCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Move down. Devices reveal top-to-bottom — first device in the list gets the next available controller slot."/>
                                        <Button Grid.Column="6" Content="✕" Width="22" Margin="2,0,0,0"
                                                Command="{Binding DataContext.Editor.RemoveCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove from profile"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ── Splitter between the two lists ─────────────────────────── -->
            <GridSplitter Grid.Row="4"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="#EEE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ToolTip="Drag to resize the lists above and below"/>

            <!-- ── Picker label + show-all ────────────────────────────────── -->
            <DockPanel Grid.Row="5" Margin="0,4,0,2">
                <CheckBox DockPanel.Dock="Right"
                          Content="Show all devices"
                          IsChecked="{Binding Editor.ShowAllHid}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"/>
                <TextBlock>
                    <Run Text="Add devices to profile"/>
                    <Run Text=" — anything you don't add stays hidden when you play"
                         Foreground="#888" FontStyle="Italic"/>
                </TextBlock>
            </DockPanel>

            <!-- ── Picker list (resizable) ────────────────────────────────── -->
            <ListBox Grid.Row="6"
                     ItemsSource="{Binding Editor.UnassignedDevices}"
                     SelectedItem="{Binding Editor.SelectedAvailable}"
                     DisplayMemberPath="FriendlyName"
                     BorderThickness="1" BorderBrush="#CCC"
                     Margin="0,0,0,6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick"
                                     Handler="PickerItem_MouseDoubleClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- ── Add buttons ────────────────────────────────────────────── -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="+ Add to profile"
                        Command="{Binding Editor.AddCommand}"
                        Padding="8,3"/>
                <Button Content="+ Add all"
                        Command="{Binding Editor.AddAllCommand}"
                        Padding="8,3" Margin="6,0,0,0"
                        ToolTip="Add every device currently shown in the picker above. Respects the &quot;Show all devices&quot; toggle — only adds what's visible."/>
            </StackPanel>

            <Separator Grid.Row="8" Margin="0,0,0,8"/>

            <!-- ── Actions row ────────────────────────────────────────────── -->
            <DockPanel Grid.Row="9" Margin="0,0,0,12">

                <!-- Save + unsaved indicator — docked right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Unsaved changes" Foreground="Orange"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding Editor.IsDirty,
                                   Converter={StaticResource BoolVisConverter}}"/>
                    <Button Content="Save Profile"
                            Command="{Binding SaveProfileCommand}"
                            Padding="14,5" Background="#3CB371" Foreground="White"/>
                </StackPanel>

                <!-- Left group: shortcuts + steam -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CreateDesktopShortcutCommand}"
                            Padding="8,4"
                            ToolTip="Create a desktop shortcut that launches this profile directly">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Desktop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CreateStartMenuShortcutCommand}"
                            Padding="8,4" Margin="6,0,0,0"
                            ToolTip="Add a shortcut to the Start Menu Programs folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Start Menu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopySteamCommandCommand}"
                            Padding="8,4" Margin="6,0,0,0"
                            ToolTip="Copy the Steam Launch Options command.&#x0a;Paste into Steam → right-click game → Properties → Launch Options.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy Steam Command" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
