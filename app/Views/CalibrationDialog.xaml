<Window x:Class="ControllerManager.Views.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timing test"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header / instructions ─────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadlineText"
                       FontSize="16" FontWeight="SemiBold"
                       Text="Measure which devices your game uses"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       Foreground="#555"
                       Text="1. Make sure the game is NOT running yet (close it if it is).&#x0a;2. Click Start game. Controller Manager captures a baseline, then launches the game for you (no hiding applied).&#x0a;3. Let it run for 30+ seconds — through the publisher splash, intros, into a menu. You don't need to do anything in-game.&#x0a;4. Click Stop. Controller Manager closes the game, captures a final snapshot, and shows which devices saw the most activity.&#x0a;&#x0a;Tip: most games claim controllers during the startup animations, well before you reach a menu. Just letting the game finish loading is usually enough."/>
        </StackPanel>

        <!-- ── Results panel (hidden until stop) ─────────────────────── -->
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="WaitingText"
                           Text="Click Start when your game is not running."
                           Margin="12" Foreground="#888" FontStyle="Italic"
                           VerticalAlignment="Top"/>

                <DataGrid x:Name="ResultsGrid"
                          Visibility="Collapsed"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F8F8"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceDescription}" Width="*"/>
                        <DataGridTextColumn Header="VID:PID" Binding="{Binding VidPidDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Reads during test" Binding="{Binding ReadsDelta}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last read" Binding="{Binding LastReadDisplay}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ── Footer buttons ────────────────────────────────────────── -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Content="Close"
                    Padding="14,4"
                    Visibility="Collapsed"
                    Click="CloseButton_Click"/>
            <Button x:Name="StopButton"
                    DockPanel.Dock="Right"
                    Content="Stop and show results"
                    Padding="14,4"
                    Visibility="Collapsed"
                    Click="StopButton_Click"/>
            <Button x:Name="StartButton"
                    DockPanel.Dock="Right"
                    Content="Start game"
                    Padding="14,4"
                    Background="#3CB371" Foreground="White"
                    Click="StartButton_Click"/>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#888"
                       Text=""/>
        </DockPanel>
    </Grid>
</Window>
